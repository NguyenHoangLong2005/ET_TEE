# Caddy gets and renews the HTTPS certificate for $DOMAIN automatically.
# Every path goes to Next, which proxies /api/** to the backend itself.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	# Android app download: files in deploy/data/downloads, e.g. /ettee.apk
	@download path /ettee.apk
	handle @download {
		root * /srv/downloads
		header Content-Disposition "attachment; filename=ettee.apk"
		file_server
	}
	# web shares the backend's network namespace (see docker-compose.yml)
	reverse_proxy backend:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
