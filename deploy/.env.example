# Copy to deploy/.env on the VPS and fill in. Never commit the real file.

# Domain whose A record points at the VPS (no https://, no www)
DOMAIN=example.com
FRONTEND_URL=https://example.com

# Supabase Postgres (same values as backend/.env)
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Generate a fresh one, do not reuse the value in backend/.env.example:  openssl rand -base64 48
AUTH_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_NAME=

# Optional payment integrations; leave empty to confirm transfers manually
SEPAY_WEBHOOK_API_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# CPU threads for the CLIP embedder; keep below the VPS core count
EMBEDDER_THREADS=2
